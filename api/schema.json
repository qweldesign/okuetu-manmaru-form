            {
              "id": "rent_budget",
              "type": "range",
              "label": "家賃のご予算（月額）",
              "unit": "千円",
              "show": {
                "field": "housing_plan",
                "in": [
                  "rent",
                  "rent_first"
                ]
              }
            },
            {
              "id": "housing_subsidy",
              "type": "checkbox",
              "label": "住宅取得の助成・支援制度について知りたい"
            }
          ]
        },
        {
          "id": "sec_work",
