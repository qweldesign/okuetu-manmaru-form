          "label": "住まいについて",
          "show": {
            "field": "support_topics",
            "includes": "housing"
          },
          "fields": [
            {
              "id": "housing_plan",
              "type": "radio",
              "label": "住まいの探し方",
              "required": true,
              "options": [
                {
                  "value": "buy",
                  "label": "購入したい"
                },
                {
                  "value": "rent",
                  "label": "賃貸を希望"
                },
                {
                  "value": "rent_first",
                  "label": "まずは賃貸、いずれ購入"
                }
              ]
            },
            {
              "id": "buy_target",
              "type": "radio",
              "label": "購入したいもの",
              "show": {
                "field": "housing_plan",
                "equals": "buy"
              },
              "options": [
                {
                  "value": "land",
                  "label": "土地のみ"
                },
                {
                  "value": "building",
                  "label": "建物のみ"
                },
                {
                  "value": "both",
                  "label": "土地と建物"
                }
