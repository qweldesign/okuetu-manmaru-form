    {
      "id": "workstay",
      "short": "ワークステイ",
      "title": "越前大野でワークステイ",
      "lead": "滞在のご希望日程と、一緒に参加される方について教えてください。",
      "show": {
        "field": "purpose",
        "equals": "workstay"
      },
      "rules": [
        {
          "type": "dateOrder",
          "from": "stay_from",
          "to": "stay_to",
          "message": "終了日は開始日より後の日付にしてください"
        }
      ],
      "fields": [
        {
          "id": "stay_plan",
          "type": "radio",
          "label": "滞在の日程",
          "required": true,
          "options": [
            {
              "value": "fixed",
              "label": "希望日が決まっている"
            },
            {
              "value": "undecided",
              "label": "まだ決まっていない"
            }
          ]
        },
        {
          "id": "stay_from",
          "type": "date",
          "label": "滞在開始の希望日",
          "required": true,
          "width": "half",
          "show": {
            "field": "stay_plan",
            "equals": "fixed"
          }
        },
        {
          "id": "stay_to",
          "type": "date",
          "label": "滞在終了の希望日",
          "required": true,
          "width": "half",
          "show": {
            "field": "stay_plan",
            "equals": "fixed"
          }
        },
        {
          "id": "stay_rough",
          "type": "text",
          "label": "おおよその時期や期間",
          "show": {
            "field": "stay_plan",
            "equals": "undecided"
          },
          "hint": "「来年の春ごろ、1週間くらい」など、わかる範囲で構いません。"
        },
        {
          "id": "workstay_jobs",
          "type": "checks",
          "label": "体験したい仕事",
          "required": true,
          "hint": "複数選べます。",
          "options": [
            {
              "value": "farming",
              "label": "農業"
            },
            {
              "value": "forest_care",
              "label": "森林整備"
            }
          ]
        },
        {
          "id": "use_house",
          "type": "radio",
          "label": "滞在にまんまるハウスを利用しますか",
          "required": true,
          "options": [
            {
              "value": "yes",
