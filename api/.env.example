# お問い合わせフォームの設定
# このファイルを .env という名前でコピーし、値を書き換えて使う。
# .env にはパスワードが含まれるため、Git には含めない（.gitignore 済み）。

# ---- サイト設定 ----
SITE_TITLE="奥越前まんまるサイト"
# 送信元チェックに使う（このサイトからの送信だけを受け付ける）
SITE_URL="https://okuetu-manmaru.com"
# ほかに受け付けるオリジン（カンマ区切り）。開発中は Vite の開発サーバーを入れる
ALLOWED_ORIGINS=""

# ---- メールアドレス ----
# 送信元。SMTP アカウントと同じドメインのアドレスにする（例は仮のもの）
MAIL_FROM="welcome@okuetu-manmaru.com"
# 通知先の既定。担当ごとの通知先が空のときはここに届き、自動返信の返信先にもなる
ADMIN_EMAIL="welcome@okuetu-manmaru.com"
# 担当ごとの通知先（カンマ区切りで複数可）。空なら ADMIN_EMAIL
NOTIFY_RELOCATION=""
NOTIFY_WORKSTAY=""
NOTIFY_HOUSE=""
NOTIFY_OTHER=""

# ---- SMTP 設定 ----
SMTP_HOST="smtp.example.com"
SMTP_USER="welcome@okuetu-manmaru.com"
SMTP_PASS="********"
SMTP_PORT=587
# tls（STARTTLS, 通常は 587 番）、ssl（SMTPS, 通常は 465 番）、none（暗号化なし。ローカルのテスト用のみ）
SMTP_SECURE=tls

# ---- 項目設定 ----
# フォーム定義（schema.json）の項目 id
NAME_FIELD=name
EMAIL_FIELD=email
PURPOSE_FIELD=purpose
# フォーム定義に沿った入力チェック（必須・形式など）を行うか。false でも氏名・メール・目的は必ず確かめる
SCHEMA_VALIDATION=true

# ---- 自動返信メールの署名 ----
# ダブルクォートの中は改行をそのまま書ける
MAIL_FOOTER="
────────────────────────────
奥越前まんまるサイト
〒912-0131 福井県大野市南六呂師
TEL: 0779-67-1117
https://okuetu-manmaru.com/
────────────────────────────
"
